<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectre.UI"
             x:Class="Spectre.UI.AppDetailView"
             x:DataType="vm:AppDetailViewModel"
             Background="{DynamicResource BgBrush}">
    <UserControl.Styles>
        <Style Selector="Border.detail-panel">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="18">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Width="54" Height="54" CornerRadius="15" Background="#183A5A">
                    <TextBlock Text="◉" FontSize="28"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{Binding DisplayName}" FontSize="25" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding EditableProcessName, StringFormat='process  /  {0}'}"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7"
                            VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{Binding StatusColor}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"
                               Foreground="{Binding StatusColor}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Classes="detail-panel" Padding="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="TOTAL PLAYTIME" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding TotalTimeFormatted}" FontSize="23"
                                   FontWeight="Bold" FontFamily="Consolas,Menlo,monospace"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="detail-panel" Padding="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="ACTIVITY LOG" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SessionCountText}" FontSize="23"
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Classes="detail-panel" Padding="18">
                <StackPanel Spacing="13">
                    <StackPanel Spacing="3">
                        <TextBlock Text="APP PROFILE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Edit how this application appears in Spectre."
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBox Text="{Binding EditableDisplayName}" PlaceholderText="Display name" />
                    <TextBox Text="{Binding EditableProcessName}" PlaceholderText="Executable process name" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF7180" FontSize="11"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="accent-button" Content="Save changes"
                                Command="{Binding SaveCommand}" Padding="17 10" />
                        <Button Classes="danger-button" Content="Delete app"
                                Command="{Binding DeleteCommand}" Padding="17 10" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBlock Text="SESSION HISTORY" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Grid.Column="1" Text="Most recent first" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionRow">
                            <Border Classes="detail-panel" Padding="14" Margin="0 0 0 8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding StartedAt}"
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                               FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Consolas,Menlo,monospace"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
    </Grid>
</UserControl>
