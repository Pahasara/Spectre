<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectre.UI"
             x:Class="Spectre.UI.AppDetailView"
             x:DataType="vm:AppDetailViewModel"
             Background="{DynamicResource BgBrush}">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{Binding DisplayName}"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" />

        <StackPanel Spacing="6">
            <TextBox Text="{Binding EditableDisplayName}" PlaceholderText="display name" />
            <TextBox Text="{Binding EditableProcessName}" PlaceholderText="process name, e.g. code, firefox" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#E5484D"
                       FontSize="12"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Command="{Binding SaveCommand}"
                        Background="{DynamicResource AccentBrush}" Foreground="White" />
                <Button Content="Delete" Command="{Binding DeleteCommand}"
                        Background="#8B1E2E" Foreground="White" />
            </StackPanel>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Sessions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionRow">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="6" Padding="10" Margin="0 0 0 6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StartedAt}"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Duration}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="Consolas,Menlo,monospace" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
